# 只在本地填写，不要把密钥提交到 Git。
DEEPSEEK_API_KEY=
GMAIL_RECIPIENT=
# 可选。默认自动查找 Android SDK 中的 ADB。
ADB_PATH=

# SilverGuide 2.0：可选的受控模型与设备配置。
# 可用本机 Ollama 做文本任务理解，需先下载模型。视觉和其他模型调用继续使用各自的配置。
# SILVERGUIDE_OLLAMA_INTENT_MODEL=qwen3:4b-instruct
# SILVERGUIDE_TEXT_MODEL=deepseek-v4-flash-vision-exp
# SILVERGUIDE_VISION_MODEL=deepseek-v4-flash-vision-exp
# SILVERGUIDE_MODEL_BASE_URL=https://api.deepseek.com
# SILVERGUIDE_DEVICE_BACKEND=mobilerun

# 高德默认由原有规则、原生控件与 OCR 主导。
# 配置改变后重启后端，再从 App 开始新任务或明确重新查询。
SILVERGUIDE_TRANSIT_EXECUTOR=rules
# 仅当已支持的规则步骤找不到预期控件时，才启用 AutoGLM 辅助。
SILVERGUIDE_AUTOGLM_ASSIST_ENABLED=false
SILVERGUIDE_AUTOGLM_MAX_CALLS=2
# 独立 AutoGLM 配置，不会替代上面的 DeepSeek 任务理解／事实提取配置。
SILVERGUIDE_AUTOGLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
SILVERGUIDE_AUTOGLM_MODEL=autoglm-phone
SILVERGUIDE_AUTOGLM_API_KEY=
# 辅助单次请求秒数上限，还受本轮路线查询剩余时间约束。
SILVERGUIDE_AUTOGLM_TIMEOUT=20
# 旧版独立实验模式仍可通过 SILVERGUIDE_TRANSIT_EXECUTOR=autoglm 指定；
# 它是全程模型决策，与上述规则主导的辅助模式不同。
# 可选预算：单次调用 1–70 秒，步骤 1–60，总时间 5–600 秒，历史 1–12 条。
# SILVERGUIDE_AUTOGLM_MAX_STEPS=30
# SILVERGUIDE_AUTOGLM_TOTAL_SECONDS=240
# SILVERGUIDE_AUTOGLM_HISTORY_LIMIT=8
